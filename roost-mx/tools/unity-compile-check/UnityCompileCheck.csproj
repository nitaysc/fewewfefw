<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-checks the Unity scripts without a Unity install, against the UnityEngine /
    UnityEditor reference assemblies from NuGet (Unity3D.SDK 2021.1) plus PackageStubs.cs
    for the uGUI, Input System and URP package APIs the game uses. It catches typos and API
    misuse; it is NOT a substitute for opening the project in Unity 6 (Unity-6-only code
    paths behind UNITY_6000_0_OR_NEWER are not checked here).
      dotnet build tools/unity-compile-check               runtime scripts
      dotnet build tools/unity-compile-check -p:Editor=true runtime + editor scripts
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0618;CS0414;CS0067;CS0649</NoWarn>
    <DefineConstants>ENABLE_INPUT_SYSTEM;ROOST_URP;ROOST_INPUT_SYSTEM;UNITY_ANDROID</DefineConstants>
    <DefineConstants Condition="'$(Editor)' == 'true'">$(DefineConstants);UNITY_EDITOR</DefineConstants>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Unity3D.SDK" Version="2021.1.14.1" GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(PkgUnity3D_SDK)/lib/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEditor" Condition="'$(Editor)' == 'true'"><HintPath>$(PkgUnity3D_SDK)/lib/UnityEditor.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Assets/RoostMX/Scripts/**/*.cs" />
    <Compile Include="../../Assets/RoostMX/Editor/**/*.cs" Condition="'$(Editor)' == 'true'" />
    <Compile Include="PackageStubs.cs" />
  </ItemGroup>
</Project>
