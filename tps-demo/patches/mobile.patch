--- a/player/player.gd
+++ b/player/player.gd
@@ -57,8 +57,12 @@ onready var sound_effect_jump = sound_effects.get_node(@"Jump")
 onready var sound_effect_land = sound_effects.get_node(@"Land")
 onready var sound_effect_shoot = sound_effects.get_node(@"Shoot")
 
+# On-screen controls (phones and tablets only).
+var touch_controls = null
+
 func _init():
-	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
+	if not Settings.touch_mode():
+		Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
 
 
 func _ready():
@@ -66,6 +70,15 @@ func _ready():
 	orientation = player_model.global_transform
 	orientation.origin = Vector3()
 
+	if Settings.touch_mode():
+		var layer = CanvasLayer.new()
+		layer.layer = 10
+		add_child(layer)
+		touch_controls = preload("res://mobile/touch_controls.gd").new()
+		touch_controls.player = self
+		touch_controls.add_to_group("touch_controls")
+		layer.add_child(touch_controls)
+
 
 func _process(delta):
 	# Fade out to black if falling out of the map. -17 is lower than
@@ -234,7 +247,9 @@ func _physics_process(delta):
 
 
 func _input(event):
-	if event is InputEventMouseMotion:
+	# Touch mode turns the camera from the touch controls instead, since Android
+	# also sends fake mouse motion for every finger drag.
+	if event is InputEventMouseMotion and touch_controls == null:
 		var camera_speed_this_frame = CAMERA_MOUSE_ROTATION_SPEED
 		if aiming:
 			camera_speed_this_frame *= 0.75
