diff --git a/menu/settings.gd b/menu/settings.gd
index ec80fb7..96f622b 100644
--- a/menu/settings.gd
+++ b/menu/settings.gd
@@ -42,9 +42,31 @@ var resolution = Resolution.NATIVE
 var fullscreen = true
 
 func _ready():
+	if OS.has_feature("mobile"):
+		# Phones: start from settings a phone GPU can cope with.
+		# They can still be raised in the Settings menu.
+		gi_quality = GIQuality.DISABLED
+		aa_quality = AAQuality.DISABLED
+		fxaa = false
+		ssao_quality = SSAOQuality.DISABLED
+		bloom_quality = BloomQuality.LOW
+		resolution = Resolution.RES_720
+		get_tree().set_quit_on_go_back(false)
 	load_settings()
 
 
+# True on phones/tablets (or when started with --touch to try the controls on a PC).
+func touch_mode():
+	return OS.has_feature("mobile") or OS.has_touchscreen_ui_hint() or "--touch" in OS.get_cmdline_args()
+
+
+# Android back button: the level handles it (back to the menu); on the menu it quits.
+func _notification(what):
+	if what == MainLoop.NOTIFICATION_WM_GO_BACK_REQUEST:
+		if get_tree().get_nodes_in_group("touch_controls").empty():
+			get_tree().quit()
+
+
 func _input(event):
 	if event.is_action_pressed("toggle_fullscreen"):
 		OS.window_fullscreen = !OS.window_fullscreen
diff --git a/player/player.gd b/player/player.gd
