; Engine configuration file.
config_version=5

[application]

config/name="Galleon"
config/description="Open-sea galleon sailing simulator (prototype)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.png"

[autoload]

Waves="*res://scripts/waves.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=740
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=true
anti_aliasing/screen_space_roughness_limiter/enabled=true
anti_aliasing/screen_space_roughness_limiter/amount=0.6
environment/ssao/quality=1
environment/ssao/half_size=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.85, 1)

[shader_globals]

displacements={
"type": "sampler2DArray",
"value": ""
}
normals={
"type": "sampler2DArray",
"value": ""
}
num_cascades={
"type": "uint",
"value": 0
}
water_color={
"type": "color",
"value": Color(0.02, 0.09, 0.2, 1)
}
foam_color={
"type": "color",
"value": Color(0.86, 0.88, 0.88, 1)
}
