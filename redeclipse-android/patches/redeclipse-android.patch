diff --git a/src/shared/glescompat.cpp b/src/shared/glescompat.cpp
new file mode 100644
index 0000000..9ff672b
--- /dev/null
+++ b/src/shared/glescompat.cpp
@@ -0,0 +1,88 @@
+// Shims for desktop OpenGL calls that OpenGL ES 3 does not have (see glescompat.h).
+#ifdef GLES
+#include "cube.h"
+
+#undef glDrawBuffer
+#undef glClearDepth
+#undef glDepthRange
+#undef glPolygonMode
+#undef glGetTexImage
+#undef glGetTexLevelParameteriv
+#undef glTexImage1D
+#undef glCompressedTexImage1D_
+#undef glGetCompressedTexImage_
+
+extern "C" {
+
+GLAPI void APIENTRY glClearDepthf(GLfloat d);
+GLAPI void APIENTRY glDepthRangef(GLfloat n, GLfloat f);
+GLAPI void APIENTRY glVertexAttrib4f(GLuint index, GLfloat x, GLfloat y, GLfloat z, GLfloat w);
+GLAPI void APIENTRY glDrawArrays(GLenum mode, GLint first, GLsizei count);
+GLAPI void APIENTRY glGetQueryObjectuiv(GLuint id, GLenum pname, GLuint *params);
+GLAPI void APIENTRY glFramebufferTextureLayer(GLenum target, GLenum attachment, GLuint texture, GLint level, GLint layer);
+GLAPI void APIENTRY glTexStorage2DMultisample(GLenum target, GLsizei samples, GLenum internalformat, GLsizei width, GLsizei height, GLboolean fixed);
+
+void glesDrawBuffer(GLenum buf)
+{
+    // ES only takes GL_BACK for the default framebuffer and COLOR_ATTACHMENTi / NONE for FBOs
+    if(buf == GL_FRONT || buf == GL_FRONT_AND_BACK) buf = GL_BACK;
+    glDrawBuffers_(1, &buf);
+}
+
+void glesClearDepth(GLdouble d) { glClearDepthf(GLfloat(d)); }
+void glesDepthRange(GLdouble n, GLdouble f) { glDepthRangef(GLfloat(n), GLfloat(f)); }
+
+// wireframe drawing is an editor feature; ES has no polygon modes
+void glesPolygonMode(GLenum, GLenum) {}
+
+// reading textures back is only used by editing and screenshot tools
+void glesGetTexImage(GLenum, GLint, GLenum, GLenum, void *) {}
+
+void glesGetTexLevelParameteriv(GLenum target, GLint level, GLenum pname, GLint *params)
+{
+    *params = 0;
+}
+
+// ES has no 1D textures; the game's shaders never sample one
+void glesTexImage1D(GLenum, GLint, GLint, GLsizei, GLint, GLenum, GLenum, const void *) {}
+void glesCompressedTexImage1D(GLenum, GLint, GLenum, GLsizei, GLint, GLsizei, const void *) {}
+void glesGetCompressedTexImage(GLenum, GLint, void *) {}
+
+// the engine sends colors as normalized bytes, which ES only accepts as floats
+void glesVertexAttrib4Nub(GLuint index, GLubyte x, GLubyte y, GLubyte z, GLubyte w)
+{
+    glVertexAttrib4f(index, x/255.0f, y/255.0f, z/255.0f, w/255.0f);
+}
+void glesVertexAttrib4Nubv(GLuint index, const GLubyte *v) { glesVertexAttrib4Nub(index, v[0], v[1], v[2], v[3]); }
+
+void glesMultiDrawArrays(GLenum mode, const GLint *first, const GLsizei *count, GLsizei n)
+{
+    for(GLsizei i = 0; i < n; i++) glDrawArrays(mode, first[i], count[i]);
+}
+
+void glesGetQueryObjectiv(GLuint id, GLenum pname, GLint *params)
+{
+    GLuint v = 0;
+    glGetQueryObjectuiv(id, pname, &v);
+    *params = GLint(v);
+}
+// timer queries are a profiling aid; report zero elapsed time
+void glesGetQueryObjectui64v(GLuint, GLenum, GLuint64 *params) { *params = 0; }
+
+void glesFramebufferTexture3D(GLenum target, GLenum attachment, GLenum, GLuint texture, GLint level, GLint layer)
+{
+    glFramebufferTextureLayer(target, attachment, texture, level, layer);
+}
+
+void glesTexImage2DMultisample(GLenum target, GLsizei samples, GLenum internalformat, GLsizei width, GLsizei height, GLboolean fixed)
+{
+    glTexStorage2DMultisample(target, samples, internalformat, width, height, fixed);
+}
+
+// output locations come from layout() qualifiers in the shader header instead
+void glesBindFragDataLocation(GLuint, GLuint, const GLchar *) {}
+void glesBindFragDataLocationIndexed(GLuint, GLuint, GLuint, const GLchar *) {}
+void glesDepthBounds(GLclampd, GLclampd) {}
+
+}
+#endif
diff --git a/src/shared/glescompat.h b/src/shared/glescompat.h
new file mode 100644
index 0000000..76f4c4c
--- /dev/null
+++ b/src/shared/glescompat.h
@@ -0,0 +1,60 @@
+// OpenGL ES 3 support for the Android port.
+// The engine is written against desktop OpenGL. On GLES we keep the desktop
+// enums in the engine's own logic and translate them at the GL call boundary:
+// rectangle textures become ordinary 2D textures (the shader header rescales
+// their pixel coordinates), and desktop-only entry points get small shims.
+#ifndef GLESCOMPAT_H
+#define GLESCOMPAT_H
+
+#ifdef GLES
+
+static inline GLenum glestarget(GLenum t) { return t == GL_TEXTURE_RECTANGLE ? GL_TEXTURE_2D : t; }
+
+#define glBindTexture(t, id) glBindTexture(glestarget(t), id)
+#define glTexImage2D(t, l, i, w, h, b, f, ty, p) glTexImage2D(glestarget(t), l, i, w, h, b, f, ty, p)
+#define glTexSubImage2D(t, l, x, y, w, h, f, ty, p) glTexSubImage2D(glestarget(t), l, x, y, w, h, f, ty, p)
+#define glCopyTexSubImage2D(t, l, xo, yo, x, y, w, h) glCopyTexSubImage2D(glestarget(t), l, xo, yo, x, y, w, h)
+#define glTexParameteri(t, n, v) glTexParameteri(glestarget(t), n, v)
+#define glTexParameterf(t, n, v) glTexParameterf(glestarget(t), n, v)
+#define glTexParameteriv(t, n, v) glTexParameteriv(glestarget(t), n, v)
+#define glTexParameterfv(t, n, v) glTexParameterfv(glestarget(t), n, v)
+#define glFramebufferTexture2D_(f, a, t, id, l) glFramebufferTexture2D_(f, a, glestarget(t), id, l)
+#define glGenerateMipmap_(t) glGenerateMipmap_(glestarget(t))
+
+// desktop-only entry points, implemented in glescompat.cpp
+extern "C" {
+void glesDrawBuffer(GLenum buf);
+void glesClearDepth(GLdouble d);
+void glesDepthRange(GLdouble n, GLdouble f);
+void glesPolygonMode(GLenum face, GLenum mode);
+void glesGetTexImage(GLenum target, GLint level, GLenum format, GLenum type, void *pixels);
+void glesGetTexLevelParameteriv(GLenum target, GLint level, GLenum pname, GLint *params);
+void glesTexImage1D(GLenum target, GLint level, GLint internalformat, GLsizei width, GLint border, GLenum format, GLenum type, const void *pixels);
+void glesCompressedTexImage1D(GLenum target, GLint level, GLenum internalformat, GLsizei width, GLint border, GLsizei size, const void *data);
+void glesGetCompressedTexImage(GLenum target, GLint level, void *img);
+void glesVertexAttrib4Nub(GLuint index, GLubyte x, GLubyte y, GLubyte z, GLubyte w);
+void glesVertexAttrib4Nubv(GLuint index, const GLubyte *v);
+void glesMultiDrawArrays(GLenum mode, const GLint *first, const GLsizei *count, GLsizei n);
+void glesGetQueryObjectiv(GLuint id, GLenum pname, GLint *params);
+void glesGetQueryObjectui64v(GLuint id, GLenum pname, GLuint64 *params);
+void glesFramebufferTexture3D(GLenum target, GLenum attachment, GLenum textarget, GLuint texture, GLint level, GLint layer);
+void glesTexImage2DMultisample(GLenum target, GLsizei samples, GLenum internalformat, GLsizei width, GLsizei height, GLboolean fixed);
+void glesBindFragDataLocation(GLuint program, GLuint color, const GLchar *name);
+void glesBindFragDataLocationIndexed(GLuint program, GLuint color, GLuint index, const GLchar *name);
+void glesDepthBounds(GLclampd zmin, GLclampd zmax);
+}
+#define glDrawBuffer glesDrawBuffer
+#define glClearDepth glesClearDepth
+#define glDepthRange glesDepthRange
+#define glPolygonMode glesPolygonMode
+#define glGetTexImage glesGetTexImage
+#define glGetTexLevelParameteriv glesGetTexLevelParameteriv
+#define glTexImage1D glesTexImage1D
+#undef glCompressedTexImage1D_
+#undef glGetCompressedTexImage_
+#define glCompressedTexImage1D_ glesCompressedTexImage1D
+#define glGetCompressedTexImage_ glesGetCompressedTexImage
+// the pointer-loaded functions above are pointed at these shims in gl_checkextensions()
+
+#endif
+#endif
