<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/rw_background</item>
        <item name="colorPrimaryDark">@color/rw_background</item>
        <item name="colorAccent">@color/rw_accent</item>
        <item name="android:windowBackground">@color/rw_background</item>
    </style>

    <!-- The theme the app runs in (Capacitor switches to it on start). Dark, edge to edge: the status and
         navigation bars are transparent and the page draws under them (MainActivity passes their size on). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/rw_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/rw_background</item>
        <item name="colorPrimaryDark">@color/rw_background</item>
        <item name="colorAccent">@color/rw_accent</item>
    </style>

    <!-- Launch screen: the icon on the app's dark background (Android 12+ draws the launcher icon on
         windowSplashScreenBackground; older versions show the splash picture). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rw_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/rw_background</item>
        <item name="android:navigationBarColor">@color/rw_background</item>
    </style>
</resources>
